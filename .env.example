# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Name of the reservations table synced from Resly
RESERVATIONS_TABLE=reservations

# Column name mapping — update these to match your actual Supabase column names.
# Run `python -m agent.main --debug-schema` to see what columns exist.
COL_PROPERTY_ID=property_id
COL_PROPERTY_NAME=property_name
COL_CHECK_IN=check_in
COL_CHECK_OUT=check_out
COL_STATUS=status
COL_NIGHTLY_RATE=nightly_rate
COL_TOTAL_AMOUNT=total_amount
COL_NIGHTS=nights
COL_CREATED_AT=created_at
COL_SOURCE=source

# Comma-separated list of statuses that count as confirmed bookings
CONFIRMED_STATUSES=confirmed,checked_in,checked_out

# ── Anthropic ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Sheets ─────────────────────────────────────────
# ID from your sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your-google-sheet-id

# Path to your Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
