# Moxxi SignalOS — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Supabase (bootstrap — everything else from Vault)
SUPABASE_URL=https://sofxjevxwlfbsruitscr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Runtime
NODE_ENV=development
LOG_LEVEL=info
SIGNULOS_VERSION=1.0.0

# Redis (local dev)
REDIS_URL=redis://localhost:6379
