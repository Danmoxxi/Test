{
  "name": "moxxi-signalos",
  "version": "1.0.0",
  "description": "Moxxi SignalOS — Multi-agent revenue intelligence operating system",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "migrate": "tsx src/database/migrate.ts",
    "seed:properties": "tsx scripts/seed-property-context.ts",
    "seed:events": "tsx scripts/seed-events-calendar.ts",
    "seed:market": "tsx scripts/seed-market-data.ts",
    "health": "tsx scripts/health-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/supabase-js": "^2.49.0",
    "axios": "^1.7.9",
    "bull": "^4.16.5",
    "grammy": "^1.35.0",
    "ioredis": "^5.4.2",
    "node-cron": "^3.0.3",
    "resend": "^4.1.0",
    "winston": "^3.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/node": "^22.12.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
